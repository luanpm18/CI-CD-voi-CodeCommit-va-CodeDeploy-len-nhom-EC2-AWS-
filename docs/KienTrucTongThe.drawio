        <mxCell id="dev_script" value="&lt;b&gt;Script: deploy.ps1&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size: 10px;&apos;&gt;1. Nén code thành file .zip&lt;br&gt;2. Upload gói lên S3&lt;br&gt;3. Kích hoạt AWS CodeDeploy&lt;br&gt;4. Theo dõi &amp;amp; chờ kết quả&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontColor=#78350F;align=left;spacingLeft=10;fontSize=11;shadow=1;" vertex="1" parent="dev_box">
          <mxGeometry x="25" y="250" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="dev_admin_ip" value="&lt;b&gt;IP Quản trị SSH&lt;/b&gt;&lt;br&gt;&lt;code&gt;14.191.90.189/32&lt;/code&gt;&lt;br&gt;&lt;span style=&apos;font-size: 10px; color: #047857;&apos;&gt;Giới hạn Port 22 bảo mật&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontColor=#065F46;fontSize=11;" vertex="1" parent="dev_box">
          <mxGeometry x="25" y="400" width="200" height="60" as="geometry" />
        </mxCell>

