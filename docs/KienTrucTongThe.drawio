        <mxCell id="aws_cloud" value="AWS CLOUD (Region: us-east-1 - N. Virginia) | Account ID: 3342-9148-4116" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF9900;strokeWidth=2;fontColor=#232F3E;fontStyle=1;startSize=30;rounded=1;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="320" y="110" width="1040" height="800" as="geometry" />
