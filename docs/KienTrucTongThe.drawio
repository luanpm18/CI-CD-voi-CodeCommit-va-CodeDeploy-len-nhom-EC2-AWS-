        <!-- Source & Storage Section -->
        <mxCell id="sec_source" value="QUẢN LÝ MÃ NGUỒN &amp; ARTIFACT REVISION" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontStyle=1;startSize=25;rounded=1;" vertex="1" parent="aws_cloud">
          <mxGeometry x="20" y="40" width="320" height="420" as="geometry" />
        </mxCell>

        <mxCell id="codecommit" value="&lt;b&gt;AWS CodeCommit&lt;/b&gt;&lt;br&gt;Repo: &lt;b&gt;cicd-demo-repo&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size: 10px; color: #475569;&apos;&gt;Vùng: us-east-1 | Branch: main&lt;br&gt;Quản lý source code &amp;amp; hook scripts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=2;fontColor=#4C1D95;fontSize=11;shadow=1;" vertex="1" parent="sec_source">
          <mxGeometry x="20" y="45" width="280" height="75" as="geometry" />
        </mxCell>

        <mxCell id="s3_bucket" value="&lt;b&gt;Amazon S3 Bucket&lt;/b&gt;&lt;br&gt;&lt;b style=&apos;color:#C2410C;&apos;&gt;cicd-bundles-334291484116&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&apos;text-align: left; font-size: 10px;&apos;&gt;• &lt;b&gt;Bucket Versioning:&lt;/b&gt; Enabled&lt;br&gt;• &lt;b&gt;Block Public Access:&lt;/b&gt; ON (403 Forbidden)&lt;br&gt;• &lt;b&gt;Default Encryption:&lt;/b&gt; SSE-S3 (AES256)&lt;br&gt;• &lt;b&gt;Revisions:&lt;/b&gt; app-v3-final.zip, app-v4-bad.zip, app-cicd-slow.zip&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#7C2D12;fontSize=11;align=center;shadow=1;" vertex="1" parent="sec_source">
          <mxGeometry x="20" y="150" width="280" height="140" as="geometry" />
        </mxCell>

        <mxCell id="iam_labrole" value="&lt;b&gt;IAM Service Role: LabRole&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size: 10px; color: #475569;&apos;&gt;Cấp quyền cho CodeDeploy điều phối EC2, đọc S3, nhận tín hiệu từ CloudWatch&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;fontColor=#991B1B;fontSize=11;" vertex="1" parent="sec_source">
          <mxGeometry x="20" y="320" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- CodeDeploy Orchestration Section -->
        <mxCell id="sec_codedeploy" value="ĐIỀU PHỐI TRIỂN KHAI (AWS CODEDEPLOY)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontStyle=1;startSize=25;rounded=1;" vertex="1" parent="aws_cloud">
          <mxGeometry x="370" y="40" width="320" height="420" as="geometry" />
        </mxCell>

        <mxCell id="cd_app" value="&lt;b&gt;CodeDeploy Application&lt;/b&gt;&lt;br&gt;&lt;b style=&apos;color:#1D4ED8;&apos;&gt;cicd-app&lt;/b&gt;&lt;br&gt;Compute Platform: EC2/On-premises" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#1E40AF;fontSize=11;shadow=1;" vertex="1" parent="sec_codedeploy">
          <mxGeometry x="20" y="45" width="280" height="65" as="geometry" />
        </mxCell>

        <mxCell id="cd_dg" value="&lt;b&gt;Deployment Group: cicd-dg-dev&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;div style=&apos;text-align: left; font-size: 10px;&apos;&gt;• &lt;b&gt;Target Instances:&lt;/b&gt; Tag &lt;code&gt;Env=dev&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Deployment Type:&lt;/b&gt; In-place&lt;br&gt;• &lt;b&gt;Strategy:&lt;/b&gt; &lt;code&gt;CodeDeployDefault.OneAtATime&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Auto-Rollback:&lt;/b&gt;&lt;br&gt;  - Rollback on Failure (E2)&lt;br&gt;  - Rollback on Alarm Triggered (E3)&lt;br&gt;• &lt;b&gt;Alarms Attached:&lt;/b&gt; 4 CloudWatch Alarms&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontColor=#1E3A8A;fontSize=11;align=center;shadow=1;" vertex="1" parent="sec_codedeploy">
          <mxGeometry x="20" y="130" width="280" height="160" as="geometry" />
        </mxCell>

        <mxCell id="cd_hooks" value="&lt;b&gt;7 Sự kiện vòng đời (Lifecycle)&lt;/b&gt;&lt;br&gt;&lt;font style=&apos;font-size: 9px; color: #334155;&apos;&gt;AppStop → DownloadBundle* → BeforeInstall → Install* → AfterInstall → AppStart → ValidateService&lt;br&gt;&lt;i&gt;(* do Agent tự động, 5 script do SV viết)&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontSize=10;" vertex="1" parent="sec_codedeploy">
          <mxGeometry x="20" y="320" width="280" height="60" as="geometry" />
        </mxCell>

        <!-- CloudWatch Monitoring Box -->
        <mxCell id="sec_cloudwatch" value="GIÁM SÁT VÀ BÁO ĐỘNG (AMAZON CLOUDWATCH)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#334155;fontStyle=1;startSize=25;rounded=1;" vertex="1" parent="aws_cloud">
          <mxGeometry x="720" y="40" width="300" height="420" as="geometry" />
        </mxCell>

        <mxCell id="cw_desc" value="&lt;b&gt;CloudWatch Alarms (4 Alarm)&lt;/b&gt;&lt;br&gt;Giám sát tải và tình trạng máy chủ EC2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2F8;strokeColor=#DB2777;fontColor=#831843;fontSize=11;" vertex="1" parent="sec_cloudwatch">
          <mxGeometry x="15" y="45" width="270" height="50" as="geometry" />
        </mxCell>

        <mxCell id="alarm_cpu" value="&lt;b&gt;Alarms: CPUUtilization &amp;gt; 80%&lt;/b&gt;&lt;br&gt;• &lt;code&gt;cicd-cpu-web-1&lt;/code&gt; (us-east-1a)&lt;br&gt;• &lt;code&gt;cicd-cpu-web-2&lt;/code&gt; (us-east-1b)&lt;br&gt;&lt;font style=&apos;font-size: 9px; color: #64748B;&apos;&gt;Ngưỡng: &amp;gt;80% trong 5 phút. Khi ALARM: dừng deployment ngay lập tức&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sec_cloudwatch">
          <mxGeometry x="15" y="110" width="270" height="80" as="geometry" />
        </mxCell>

        <mxCell id="alarm_status" value="&lt;b&gt;Alarms: StatusCheckFailed ≥ 1&lt;/b&gt;&lt;br&gt;• &lt;code&gt;cicd-status-web-1&lt;/code&gt;&lt;br&gt;• &lt;code&gt;cicd-status-web-2&lt;/code&gt;&lt;br&gt;&lt;font style=&apos;font-size: 9px; color: #64748B;&apos;&gt;Ngưỡng: ≥1 lỗi phần cứng/hệ điều hành trong 1 phút&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;fontColor=#881337;fontSize=10;align=left;spacingLeft=8;" vertex="1" parent="sec_cloudwatch">
          <mxGeometry x="15" y="205" width="270" height="75" as="geometry" />
        </mxCell>

        <mxCell id="cw_action" value="&lt;b&gt;Tác động tới Deployment Group:&lt;/b&gt;&lt;br&gt;Kích hoạt &lt;b&gt;DEPLOYMENT_STOP_ON_ALARM&lt;/b&gt;&lt;br&gt;→ Dừng deployment đang chạy&lt;br&gt;→ Tự động Rollback về bản v3-final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontColor=#7F1D1D;fontSize=10;align=center;" vertex="1" parent="sec_cloudwatch">
          <mxGeometry x="15" y="300" width="270" height="80" as="geometry" />
        </mxCell>

