        <mxCell id="dev_git" value="&lt;b&gt;Git Client&lt;/b&gt;&lt;br&gt;Commit &amp;amp; Push mã nguồn&lt;br&gt;&lt;code&gt;v3-final&lt;/code&gt; / &lt;code&gt;cicd-bad&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontColor=#1E3A8A;fontSize=11;" vertex="1" parent="dev_box">
